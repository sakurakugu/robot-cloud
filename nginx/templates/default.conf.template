server {
    listen 80;
    server_name ${SERVER_NAME};
    client_max_body_size 200m;
    resolver 127.0.0.11 valid=30s ipv6=off;
    resolver_timeout 5s;

    set $backend_origin http://${BACKEND_UPSTREAM};
    set $frontend_origin http://${FRONTEND_UPSTREAM};
    set $media_origin http://${MEDIA_UPSTREAM};

    location /api/ {
        proxy_pass $backend_origin;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /media/ {
        proxy_pass $media_origin/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_redirect ~^http://[^/]+/(.*)$ /media/$1;
        proxy_redirect ~^/(.*)$ /media/$1;
    }

    location / {
        proxy_pass $frontend_origin;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
